{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbi-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // One-page site: unknown paths get a real 404 with dist/404.html,
    // not the single-page-app fallback to index.html.
    "not_found_handling": "404-page"
  }
}
